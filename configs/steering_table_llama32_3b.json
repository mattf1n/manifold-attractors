      "outputs": ["data/language_steering_confirmatory-llama3.2-3b/prepared.json"],
      "deps": []
    },
    {
      "id": "data-adaptive_steering_llama32_3b-compute",
      "module": "manifold_attractors.steering.compute",
      "args": ["--root", "data/language_steering_confirmatory-llama3.2-3b"],
      "outputs": ["data/language_steering_confirmatory-llama3.2-3b/computed.json", "data/language_steering_confirmatory-llama3.2-3b/summary.json", "data/language_steering_confirmatory-llama3.2-3b/final_validation.json"],
      "deps": ["data-adaptive_steering_llama32_3b-prepare"]
    },
    {
      "id": "data-adaptive_steering_llama32_3b-oracle",
      "module": "manifold_attractors.steering.oracle",
      "args": ["all", "--root", "data/language_steering_confirmatory-llama3.2-3b"],
